pragma solidity ^0.8.21;

import {Vm} from "forge-std/Vm.sol";

interface IFileStore {
    function getFile(string memory filename) external view returns (IFile);

    function fileExists(string memory filename) external view returns (bool);
}

interface IFile {
    function read() external view returns (string memory);
}

/**
 * @author Ella Whit
 * @title GRIDSEARCH
 * @notice Uses subsets from my custom font GEOM stored on ETHFS
 * @dev Refactored to resolve stack overflow issues
 */
contract BasicGHZRenderer {
    IFileStore constant fileStore =
        IFileStore(0x9746fD0A77829E12F8A9DBe70D7a322412325B91);
    Vm constant vm =
        Vm(address(bytes20(uint160(uint256(keccak256("hevm cheat code"))))));

    string constant LOCAL_FONT_DATA =
        "";

    // Struct to hold shape data to reduce local variables
    struct ShapeData {
        uint256 seed1;
        uint256 seed2;
        string color1;
        string color2;
    }

    // Struct to hold letter data
    struct LetterData {
        string col;
        string plain;
    }

    function getFontData() internal view returns (string memory) {
        // First try local embedded font data
        if (bytes(LOCAL_FONT_DATA).length > 0) {
            return LOCAL_FONT_DATA;
        }

        // Try to get font from ETHFS
        try this.tryGetFontFromETHFS() returns (string memory fontData) {
            return fontData;
        } catch {
            // Return empty string if both fail
            return "";
        }
    }

    function tryGetFontFromETHFS() external view returns (string memory) {
        string memory fontFileName = "ghz.txt.txt";

        if (fileStore.fileExists(fontFileName)) {
            IFile fontFile = fileStore.getFile(fontFileName);
            return fontFile.read();
        }

        return "";
    }

    // Helper function to test if font file exists locally
    function localFontExists() external pure returns (bool) {
        return bytes(LOCAL_FONT_DATA).length > 0;
    }

    // Helper function to test if font file exists on ETHFS
    function ethfsFontExists() external view returns (bool) {
        try this.tryGetFontFromETHFS() returns (string memory fontData) {
            return bytes(fontData).length > 0;
        } catch {
            return false;
        }
    }

    // Helper function to get font data for debugging
    function getFontDataForTesting() external view returns (string memory) {
        return getFontData();
    }

    // Get info about font source for debugging
    function getFontSource() external view returns (string memory) {
        if (bytes(LOCAL_FONT_DATA).length > 0) {
            return
                string.concat(
                    "LOCAL_EMBEDDED_",
                    toString(bytes(LOCAL_FONT_DATA).length),
                    "_chars"
                );
        }

        try this.tryGetFontFromETHFS() returns (string memory ethfsFont) {
            if (bytes(ethfsFont).length > 0) {
                return
                    string.concat(
                        "ETHFS_",
                        toString(bytes(ethfsFont).length),
                        "_chars"
                    );
            }
        } catch {
            // Continue
        }

        return "FALLBACK_SERIF";
    }

    // Get the first 100 characters of the font data for debugging
    function getFontPreview() external view returns (string memory) {
        string memory fontData = getFontData();
        bytes memory fontBytes = bytes(fontData);

        if (fontBytes.length == 0) {
            return "NO_FONT_DATA";
        }

        uint256 previewLength = fontBytes.length > 100 ? 100 : fontBytes.length;
        bytes memory preview = new bytes(previewLength);

        for (uint256 i = 0; i < previewLength; i++) {
            preview[i] = fontBytes[i];
        }

        return string(preview);
    }

    // Simple version without font (fallback)
    function renderSVGWithoutFont() external pure returns (string memory) {
        return
            string.concat(
                '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500">',
                '<rect width="500" height="500" fill="black"/>',
                '<text font-family="serif" font-size="20" x="250" y="250" fill="white" text-anchor="middle">GHZ</text>',
                "</svg>"
            );
    }

    /* ============================================================= */
    /*      PLAIN BLACK BACKGROUND  ·  12×12 GRID  ·  CLIP MASK       */
    /* ============================================================= */

    function renderSVG(uint256 tokenId) public view returns (string memory) {
        return _build(tokenId, getFontData());
    }

    /* ===== get animation transform ===== */
    function _getAnimationTransform(
        uint256 seed
    ) internal pure returns (string memory) {
        return _createAnimationTransform(seed);
    }

    // Extracted animation transform creation to separate function
    function _createAnimationTransform(
        uint256 seed
    ) internal pure returns (string memory) {
        uint256 moveSeed = seed >> 200;
        int256 deltaX = int256((moveSeed & 0xFF) % 60) - 30;
        int256 deltaY = int256(((moveSeed >> 8) & 0xFF) % 60) - 30;

        string memory dx = deltaX >= 0
            ? uint2str(uint256(deltaX))
            : string.concat("-", uint2str(uint256(-deltaX)));
        string memory dy = deltaY >= 0
            ? uint2str(uint256(deltaY))
            : string.concat("-", uint2str(uint256(-deltaY)));

        return
            string.concat(
                '<animateTransform attributeName="transform" type="translate" values="0,0;',
                dx,
                ",",
                dy,
                ';0,0" dur="4s" repeatCount="indefinite"/>'
            );
    }

    /* ===== core builder - refactored to reduce stack depth ===== */
    function _build(
        uint256 id,
        string memory font
    ) internal pure returns (string memory) {
        uint256 seed = uint256(keccak256(abi.encodePacked(id)));
        return _buildSVGContent(seed, font);
    }

    // Split building into separate function to manage stack
    function _buildSVGContent(
        uint256 seed,
        string memory font
    ) internal pure returns (string memory) {
        (string memory A, string memory B, string memory C) = _palette(seed);

        // Create shape data struct to reduce locals
        ShapeData memory shapes = ShapeData({
            seed1: seed,
            seed2: seed >> 1,
            color1: _pickColour(seed, A, B, C),
            color2: _pickColour(seed >> 1, A, B, C)
        });

        return _assembleSVG(seed, font, A, B, C, shapes);
    }

    // Assemble final SVG with reduced locals
    function _assembleSVG(
        uint256 seed,
        string memory font,
        string memory A,
        string memory B,
        string memory C,
        ShapeData memory shapes
    ) internal pure returns (string memory) {
        // Generate shapes
        string memory s1 = _blurShape(shapes.seed1, shapes.color1);
        string memory s2 = _blurShape(shapes.seed2, shapes.color2);

        // Generate letters
        LetterData memory letters = _generateLetters(seed, A, B, C);

        // Generate defs
        string memory defs = _defs(seed, font, A, B, C);

        return _createFinalSVG(defs, s1, s2, seed, letters);
    }

    // Create final SVG structure
    function _createFinalSVG(
        string memory defs,
        string memory s1,
        string memory s2,
        uint256 seed,
        LetterData memory letters
    ) internal pure returns (string memory) {
        string memory part1 = string.concat(
            '<svg viewBox="0 0 480 480"><rect width="480" height="480" fill="#000"/>',
            defs,
            s1,
            s2
        );

        string memory part2 = string.concat(
            // black overlap patch
            '<rect width="480" height="480" fill="#000" clip-path="url(#inter)"/>',
            '<g filter="url(#textGlow)">',
            // coloured text everywhere first (background layer)
            '<g font-family="g" font-size="32">',
            letters.col,
            "</g>",
            // black text on top of any shapes (foreground layer)
            _createBlackTextOverShapes(seed, letters.plain),
            "</g>"
        );

        return string.concat(part1, part2, "</svg>");
    }

    // Create black text over shapes
    function _createBlackTextOverShapes(
        uint256 seed,
        string memory plain
    ) internal pure returns (string memory) {
        // Create a union clip path for both shapes combined
        // Black text should appear wherever there are shapes (s1 OR s2)
        return
            string.concat(
                // black text inside any shape area
                '<g clip-path="url(#shapes-union)" fill="#000" font-family="g" font-size="32">',
                plain,
                "</g>"
            );
    }

    /* ===== defs helper - split into smaller functions ===== */
    function _defs(
        uint256 seed,
        string memory font,
        string memory A,
        string memory B,
        string memory C
    ) internal pure returns (string memory) {
        string memory filters = _createFilters();
        string memory clips = _createClipPaths(seed, A, B, C);
        string memory styles = _createStyles(A, B, C, font);

        return string.concat("<defs>", filters, clips, styles, "</defs>");
    }

    // Create filter definitions
    function _createFilters() internal pure returns (string memory) {
        string memory blurFilter = string.concat(
            // blur shine filter for shapes
            '<filter id="blur" x="-50%" y="-50%" width="200%" height="200%">',
            '<feGaussianBlur in="SourceGraphic" stdDeviation="4" result="blur"/>',
            '<feColorMatrix in="blur" type="matrix" values="3 0 0 0 0.5 0 3 0 0 0.5 0 0 3 0 0.5 0 0 0 1 0"/>',
            '<feGaussianBlur stdDeviation="12" result="glow"/>',
            '<feColorMatrix in="glow" type="saturate" values="2"/>',
            '<feMerge><feMergeNode in="glow"/><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>',
            "</filter>"
        );

        string memory textGlowFilter = string.concat(
            // text glow filter
            '<filter id="textGlow" x="-50%" y="-50%" width="200%" height="200%">',
            '<feGaussianBlur in="SourceGraphic" stdDeviation="1.5" result="blur"/>',
            '<feColorMatrix in="blur" type="matrix" values="1.3 0 0 0 0.2 0 1.3 0 0 0.2 0 0 1.3 0 0.2 0 0 0 1 0"/>',
            '<feGaussianBlur stdDeviation="4" result="glow"/>',
            '<feMerge><feMergeNode in="glow"/><feMergeNode in="SourceGraphic"/></feMerge>',
            "</filter>"
        );

        return string.concat(blurFilter, textGlowFilter);
    }

    // Create clip path definitions
    function _createClipPaths(
        uint256 seed,
        string memory A,
        string memory B,
        string memory C
    ) internal pure returns (string memory) {
        string memory color1 = _pickColour(seed, A, B, C);
        string memory color2 = _pickColour(seed >> 1, A, B, C);

        string memory shape1 = _shape(seed, color1);
        string memory shape2 = _shape(seed >> 1, color2);

        string memory basicClips = string.concat(
            // static base shape clips (no animation)
            '<clipPath id="s1">',
            shape1,
            "</clipPath>",
            '<clipPath id="s2">',
            shape2,
            "</clipPath>"
        );

        string memory exclusionClips = string.concat(
            // s1 only = s1 − s2
            '<clipPath id="s1only" clip-rule="evenodd">',
            shape1,
            shape2,
            "</clipPath>",
            // s2 only = s2 − s1
            '<clipPath id="s2only" clip-rule="evenodd">',
            shape2,
            shape1,
            "</clipPath>"
        );

        string memory unionAndIntersectionClips = string.concat(
            // union of both shapes (s1 OR s2) - for black text
            '<clipPath id="shapes-union">',
            "<g>",
            shape1,
            shape2,
            "</g>",
            "</clipPath>",
            // intersection = s1 ∩ s2
            '<clipPath id="inter"><g clip-path="url(#s1)"><use href="#s2"/></g></clipPath>'
        );

        return
            string.concat(
                basicClips,
                exclusionClips,
                unionAndIntersectionClips
            );
    }

    // Create style definitions
    function _createStyles(
        string memory A,
        string memory B,
        string memory C,
        string memory font
    ) internal pure returns (string memory) {
        string memory colorStyles = string.concat(
            // palette + font
            "<style>",
            ".a{fill:",
            A,
            "}.b{fill:",
            B,
            "}.c{fill:",
            C,
            "}"
        );

        string memory fontStyle = bytes(font).length > 0
            ? string.concat(
                "@font-face{font-family:g;src:url(data:application/font-woff2;base64,",
                font,
                ') format("woff2");}'
            )
            : "";

        return string.concat(colorStyles, fontStyle, "</style>");
    }

    /* ===== blur shape builder ===== */
    function _blurShape(
        uint256 s,
        string memory fill
    ) internal pure returns (string memory) {
        string memory shape = _shape(s, fill);
        string memory animation = _createBlurShapeAnimation(s);

        // wrap the shape with intense glow filter and animation
        return
            string.concat('<g filter="url(#blur)">', animation, shape, "</g>");
    }

    // Create blur shape animation
    function _createBlurShapeAnimation(
        uint256 s
    ) internal pure returns (string memory) {
        // generate random movement direction from seed
        uint256 moveSeed = s >> 200;
        int256 deltaX = int256((moveSeed & 0xFF) % 60) - 30; // -30 to +29
        int256 deltaY = int256(((moveSeed >> 8) & 0xFF) % 60) - 30; // -30 to +29

        string memory dx = deltaX >= 0
            ? uint2str(uint256(deltaX))
            : string.concat("-", uint2str(uint256(-deltaX)));
        string memory dy = deltaY >= 0
            ? uint2str(uint256(deltaY))
            : string.concat("-", uint2str(uint256(-deltaY)));

        return
            string.concat(
                '<animateTransform attributeName="transform" type="translate" values="0,0;',
                dx,
                ",",
                dy,
                ';0,0" dur="4s" repeatCount="indefinite"/>'
            );
    }

    /* ===== letters - refactored to use struct ===== */
    function _generateLetters(
        uint256 seed,
        string memory A,
        string memory B,
        string memory C
    ) internal pure returns (LetterData memory) {
        return _letters(seed, A, B, C);
    }

    function _letters(
        uint256 seed,
        string memory A,
        string memory B,
        string memory C
    ) internal pure returns (LetterData memory result) {
        for (uint256 r; r < 12; r++) {
            for (uint256 c; c < 12; c++) {
                seed = uint256(keccak256(abi.encodePacked(seed, r, c)));
                if (seed % 100 < 30) {
                    string memory x = uint2str(c * 40 + 20);
                    string memory y = uint2str(r * 40 + 20);
                    string memory L = seed % 3 == 0 ? "G" : seed % 3 == 1
                        ? "H"
                        : "Z";
                    string memory cls = (seed >> 8) % 3 == 0
                        ? "a"
                        : (seed >> 8) % 3 == 1
                        ? "b"
                        : "c";
                    result.col = string.concat(
                        result.col,
                        "<text class=",
                        cls,
                        " x=",
                        x,
                        " y=",
                        y,
                        ">",
                        L,
                        "</text>"
                    );
                    result.plain = string.concat(
                        result.plain,
                        "<text x=",
                        x,
                        " y=",
                        y,
                        ">",
                        L,
                        "</text>"
                    );
                }
            }
        }
    }

    /* ===== colour picker ===== */
    function _pickColour(
        uint256 s,
        string memory A,
        string memory B,
        string memory C
    ) internal pure returns (string memory) {
        uint256 i = (s >> 160) % 3;
        return i == 0 ? A : i == 1 ? B : C;
    }

    /* ===== shape builder ===== */
    function _shape(
        uint256 s,
        string memory fill
    ) internal pure returns (string memory) {
        uint256 rSeed = s >> 96; // for positions
        if ((s & 7) != 0) {
            uint256 r = 60 + (s % 120);
            uint256 cx = 40 + ((rSeed >> 16) % 400);
            uint256 cy = 40 + ((rSeed >> 32) % 400);
            return
                string.concat(
                    "<circle cx=",
                    uint2str(cx),
                    " cy=",
                    uint2str(cy),
                    " r=",
                    uint2str(r),
                    ' fill="',
                    fill,
                    '"/>'
                );
        }
        uint256 sz = 120 + (s % 120);
        uint256 max = 480 - sz;
        uint256 x0 = (rSeed >> 48) % max;
        return
            string.concat(
                "<rect x=",
                uint2str(x0),
                " y=",
                uint2str(x0),
                " width=",
                uint2str(sz),
                " height=",
                uint2str(sz),
                ' fill="',
                fill,
                '"/>'
            );
    }

    /* ===== palette ===== */
    function _palette(
        uint256 s
    ) internal pure returns (string memory, string memory, string memory) {
        uint256 i = (s >> 4) % 3;
        if (i == 0) return ("#7BDFF2", "#FCFCB1", "#FBACBE");
        if (i == 1) return ("#FBACBE", "#FCFCB1", "#7BDFF2");
        return ("#5EC2B7", "#FCFCB1", "#EF6F6C");
    }

    /* ---------- helpers ---------- */
    function uint2str(uint256 v) internal pure returns (string memory) {
        if (v == 0) return "0";
        uint256 digits;
        uint256 tmp = v;
        while (tmp != 0) {
            digits++;
            tmp /= 10;
        }
        bytes memory buf = new bytes(digits);
        while (v != 0) {
            digits--;
            buf[digits] = bytes1(uint8(48 + (v % 10)));
            v /= 10;
        }
        return string(buf);
    }

    function toString(uint256 v) internal pure returns (string memory) {
        return uint2str(v);
    }
}
